<%
const rawLabel = typeof label !== 'undefined' && label ? String(label) : 'Registered';
const rawOwner = typeof ownerType !== 'undefined' && ownerType ? String(ownerType) : '';
const lower = rawLabel.toLowerCase();
let pillClass = 'status-pill-registered';
let pillIcon = 'package';
if (lower.includes('fake') || lower.includes('flagged') || lower.includes('not found') || lower.includes('not verified')) {
    pillClass = 'status-pill-alert';
    pillIcon = 'alert';
} else if (rawOwner === 'Consumer' || lower.includes('genuine') || lower.includes('verified') || lower.includes('delivered') || lower.includes('registered on chain')) {
    pillClass = 'status-pill-verified';
    pillIcon = 'check';
} else if (rawOwner === 'Seller' || lower.includes('seller') || lower.includes('review')) {
    pillClass = 'status-pill-transit';
    pillIcon = 'store';
}
%>
<span class="status-pill <%= pillClass %>">
    <%- include('icon', { name: pillIcon, px: 12 }) %>
    <span><%= rawLabel %></span>
</span>
