<%
// Shared sign-in page for manufacturer, seller and consumer.
// `role` picks the tab that starts selected; the tabs switch the form target client-side.
const roles = [
  { key: 'manufacturer', label: 'Manufacturer' },
  { key: 'seller', label: 'Seller' },
  { key: 'consumer', label: 'Consumer' }
];
const current = roles.find(function (r) { return r.key === role; }) || roles[0];
%>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= current.label %> Sign in · ProductGuard</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --lp-ink: #2F4156;
            --lp-muted: #567C8D;
            --lp-mist: #C8D9E6;
            --lp-sand: #F5EFEB;
            --lp-danger: #B4413C;
        }
        * { box-sizing: border-box; }
        body {
            margin: 0;
            background: var(--lp-mist);
            font-family: 'Plus Jakarta Sans', sans-serif;
            color: var(--lp-ink);
            -webkit-font-smoothing: antialiased;
        }
        a { color: var(--lp-ink); text-decoration: none; }
        a:hover { color: var(--lp-muted); }
        input::placeholder { color: var(--lp-muted); }

        .lp-frame { min-height: 100vh; display: flex; }
        .lp-card {
            position: relative;
            flex: 1;
            min-height: 100vh;
            background: #fff;
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }
        .lp-canvas { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }

        .lp-nav {
            position: relative;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 32px;
            padding: 28px 24px;
            flex-wrap: wrap;
        }
        .lp-brand { display: flex; align-items: center; gap: 8px; font-weight: 700; font-size: 15px; }
        .lp-home { font-size: 14px; color: var(--lp-muted); }

        .lp-main {
            position: relative;
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
        }
        .lp-panel { width: min(100%, 400px); display: flex; flex-direction: column; gap: 28px; }
        .lp-title {
            margin: 0;
            text-align: center;
            font-size: 36px;
            line-height: 1.1;
            font-weight: 600;
            letter-spacing: -0.035em;
        }
        .lp-title span { display: block; }
        .lp-title .lp-accent { color: var(--lp-muted); }

        .lp-tabs {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            padding: 4px;
            background: var(--lp-sand);
            border-radius: 999px;
        }
        .lp-tab {
            height: 36px;
            border: 0;
            border-radius: 999px;
            font: inherit;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            background: transparent;
            color: var(--lp-muted);
            transition: background .2s, color .2s, box-shadow .2s;
        }
        .lp-tab[aria-selected="true"] {
            background: #fff;
            color: var(--lp-ink);
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        }
        .lp-tab:focus-visible { outline: 2px solid var(--lp-ink); outline-offset: 2px; }

        .lp-error {
            margin: 0;
            padding: 12px 20px;
            border-radius: 16px;
            background: #FBEDEC;
            color: var(--lp-danger);
            font-size: 13px;
            font-weight: 600;
            text-align: center;
        }

        .lp-form { display: flex; flex-direction: column; gap: 12px; }
        .lp-field {
            height: 48px;
            padding: 0 20px;
            border: 1px solid var(--lp-mist);
            border-radius: 999px;
            font: inherit;
            font-size: 14px;
            outline: 0;
            background: #fff;
            color: var(--lp-ink);
            transition: border-color .2s;
        }
        .lp-field:focus, .lp-pw:focus-within { border-color: var(--lp-ink); }
        .lp-pw {
            display: flex;
            align-items: center;
            height: 48px;
            padding: 0 8px 0 20px;
            border: 1px solid var(--lp-mist);
            border-radius: 999px;
            background: #fff;
            transition: border-color .2s;
        }
        .lp-pw input {
            flex: 1;
            min-width: 0;
            border: 0;
            outline: 0;
            font: inherit;
            font-size: 14px;
            background: transparent;
            color: var(--lp-ink);
        }
        .lp-pw button {
            height: 32px;
            padding: 0 12px;
            border: 0;
            background: transparent;
            font: inherit;
            font-size: 12px;
            font-weight: 600;
            color: var(--lp-muted);
            cursor: pointer;
        }
        .lp-submit {
            margin-top: 4px;
            height: 48px;
            border: 0;
            border-radius: 999px;
            background: var(--lp-ink);
            color: #fff;
            font: inherit;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            box-shadow: 0 8px 18px -6px rgba(47, 65, 86, 0.28), 0 4px 14px -6px rgba(86, 124, 141, 0.25);
            transition: background .2s;
        }
        .lp-submit:hover { background: var(--lp-muted); }

        .lp-alt { display: flex; justify-content: center; gap: 6px; font-size: 13px; color: var(--lp-muted); }
        .lp-alt a { font-weight: 600; }
        .lp-spacer { height: 72px; }

        @media (max-width: 600px) {
            .lp-spacer { height: 24px; }
        }
    </style>
</head>
<body>
<div class="lp-frame">
    <div class="lp-card">
        <canvas class="lp-canvas" id="lpCanvas" aria-hidden="true"></canvas>

        <nav class="lp-nav">
            <a href="/" class="lp-brand">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="#2F4156" aria-hidden="true"><path d="M12 2 4 5v7c0 6 8 10 8 10s8-4 8-10V5z"></path></svg>
                ProductGuard
            </a>
            <a href="/" class="lp-home">Home</a>
        </nav>

        <main class="lp-main">
            <div class="lp-panel">
                <h1 class="lp-title">
                    <span class="lp-accent">Welcome</span>
                    <span>Sign in</span>
                </h1>

                <div class="lp-tabs" role="tablist" aria-label="Account type">
                    <% roles.forEach(function (r) { %>
                    <button type="button" class="lp-tab" role="tab" data-role="<%= r.key %>" data-label="<%= r.label %>" aria-selected="<%= r.key === current.key ? 'true' : 'false' %>"><%= r.label %></button>
                    <% }); %>
                </div>

                <% if (typeof error !== 'undefined' && error) { %>
                <p class="lp-error" role="alert"><%= error %></p>
                <% } %>

                <form class="lp-form" id="lpForm" method="POST" action="/<%= current.key %>/login">
                    <input class="lp-field" type="email" name="email" placeholder="Email" aria-label="Email" autocomplete="email" required>
                    <div class="lp-pw">
                        <input id="lpPassword" type="password" name="password" placeholder="Password" aria-label="Password" autocomplete="current-password" required>
                        <button type="button" id="lpTogglePw" aria-controls="lpPassword">Show</button>
                    </div>
                    <button type="submit" class="lp-submit" id="lpSubmit">Sign in as <%= current.label %></button>
                </form>

                <div class="lp-alt">
                    <span>New here?</span>
                    <a href="/<%= current.key %>/register" id="lpRegister">Create account</a>
                </div>
            </div>
        </main>
        <div class="lp-spacer"></div>
    </div>
</div>

<script>
(function () {
    var form = document.getElementById('lpForm');
    var submit = document.getElementById('lpSubmit');
    var register = document.getElementById('lpRegister');
    var tabs = document.querySelectorAll('.lp-tab');

    // Switching tabs retargets the form and keeps the URL in step, so a refresh or
    // a failed login lands back on the same role.
    tabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
            var role = tab.getAttribute('data-role');
            tabs.forEach(function (t) { t.setAttribute('aria-selected', t === tab ? 'true' : 'false'); });
            form.setAttribute('action', '/' + role + '/login');
            register.setAttribute('href', '/' + role + '/register');
            submit.textContent = 'Sign in as ' + tab.getAttribute('data-label');
            document.title = tab.getAttribute('data-label') + ' Sign in · ProductGuard';
            var err = document.querySelector('.lp-error');
            if (err) err.remove();
            try { window.history.replaceState(null, '', '/' + role + '/login' + window.location.search); } catch (e) {}
        });
    });

    var pw = document.getElementById('lpPassword');
    var toggle = document.getElementById('lpTogglePw');
    toggle.addEventListener('click', function () {
        var show = pw.type === 'password';
        pw.type = show ? 'text' : 'password';
        toggle.textContent = show ? 'Hide' : 'Show';
    });

    // Static dot field.
    var canvas = document.getElementById('lpCanvas');
    function draw() {
        var dpr = window.devicePixelRatio || 1, w = canvas.offsetWidth, h = canvas.offsetHeight;
        canvas.width = w * dpr;
        canvas.height = h * dpr;
        var x = canvas.getContext('2d');
        x.scale(dpr, dpr);
        x.fillStyle = '#2F4156';
        var seed = 11;
        function rnd() { return (seed = (seed * 16807) % 2147483647) / 2147483647; }
        var blobs = [
            { cx: w * 0.06, cy: h * 0.5, rx: w * 0.2, ry: h * 0.22 },
            { cx: w * 0.95, cy: h * 0.55, rx: w * 0.18, ry: h * 0.2 }
        ];
        for (var py = 0; py < h; py += 7) {
            for (var px = 0; px < w; px += 7) {
                var d = 0;
                for (var i = 0; i < blobs.length; i++) {
                    var b = blobs[i];
                    var dx = (px - b.cx) / b.rx, dy = (py - b.cy) / b.ry;
                    d = Math.max(d, 1 - Math.sqrt(dx * dx + dy * dy));
                }
                d += Math.sin(px * 0.02 + py * 0.05) * 0.12;
                if (d <= 0 || rnd() > d * 1.6) continue;
                x.globalAlpha = Math.min(1, d * 1.5);
                x.beginPath();
                x.arc(px, py, 0.6 + Math.min(1, d) * 1.6, 0, 7);
                x.fill();
            }
        }
    }
    window.addEventListener('resize', draw);
    draw();
})();
</script>

<%# The shared footer partial starts with </main> and adds the auth-token and toast scripts. %>
<main hidden>
<%- include('footer') %>
