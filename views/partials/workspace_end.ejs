            </main>
        </div>
    </div>

    <script>
        (function() {
            const shell = document.getElementById("wsShell");
            const sidebar = document.getElementById("wsSidebar");
            const overlay = document.getElementById("wsOverlay");
            const menuBtn = document.getElementById("wsMenuBtn");
            const drawerCloseBtn = document.getElementById("wsDrawerClose");
            const collapseBtn = document.getElementById("wsCollapseBtn");

            if (shell && localStorage.getItem("pg_sidebar_collapsed") === "1") {
                shell.classList.add("collapsed");
            }

            if (collapseBtn && shell) {
                collapseBtn.addEventListener("click", function() {
                    shell.classList.toggle("collapsed");
                    localStorage.setItem("pg_sidebar_collapsed", shell.classList.contains("collapsed") ? "1" : "0");
                });
            }

            function closeDrawer() {
                if (sidebar) sidebar.classList.remove("open");
                if (overlay) overlay.classList.remove("open");
            }

            if (menuBtn && sidebar && overlay) {
                menuBtn.addEventListener("click", function() {
                    sidebar.classList.toggle("open");
                    overlay.classList.toggle("open");
                });
                overlay.addEventListener("click", closeDrawer);
                if (drawerCloseBtn) drawerCloseBtn.addEventListener("click", closeDrawer);
                sidebar.querySelectorAll(".ws-nav-link").forEach(function(link) {
                    link.addEventListener("click", closeDrawer);
                });
                document.addEventListener("keydown", function(e) {
                    if (e.key === "Escape") closeDrawer();
                });
            }

            document.querySelectorAll("form").forEach(function(form) {
                form.addEventListener("submit", function(e) {
                    if (form.dataset.submitting === "1") {
                        e.preventDefault();
                        return;
                    }
                    form.dataset.submitting = "1";
                    const loader = document.getElementById("loading");
                    if (loader) loader.style.display = "flex";
                });
            });
        })();
    </script>
    <script>
        (function() {
            var usingCookies = <%- JSON.stringify(Boolean(typeof usingCookieAuth !== 'undefined' && usingCookieAuth)) %>;
            var serverToken = <%- JSON.stringify(typeof fallbackAuthToken !== 'undefined' && fallbackAuthToken ? fallbackAuthToken : '') %>;
            var storageKey = 'pg_auth_token';

            try {
                var curParams = new URLSearchParams(window.location.search);
                if (curParams.get('logged_out') === '1') {
                    sessionStorage.removeItem(storageKey);
                    curParams.delete('logged_out');
                    var cleanAfterLogout = window.location.pathname + (curParams.toString() ? '?' + curParams.toString() : '') + window.location.hash;
                    window.history.replaceState(null, '', cleanAfterLogout);
                } else if (usingCookies) {
                    sessionStorage.removeItem(storageKey);
                } else if (serverToken) {
                    sessionStorage.setItem(storageKey, serverToken);
                }
            } catch (e) {}

            var token = serverToken;
            if (!token && !usingCookies) {
                try { token = sessionStorage.getItem(storageKey) || ''; } catch (e) {}
            }

            function addToken(urlStr) {
                if (!token || !urlStr || urlStr.startsWith('#') || urlStr.startsWith('javascript:')) return urlStr;
                try {
                    var u = new URL(urlStr, window.location.origin);
                    if (u.origin !== window.location.origin) return urlStr;
                    if (!u.searchParams.has('_auth')) u.searchParams.set('_auth', token);
                    return u.pathname + u.search + u.hash;
                } catch (e) {
                    return urlStr;
                }
            }

            window.pgWithAuth = addToken;

            if (token) {
                try {
                    var curUrl = new URL(window.location.href);
                    if (!curUrl.searchParams.has('_auth')) {
                        curUrl.searchParams.set('_auth', token);
                        window.history.replaceState(null, '', curUrl.pathname + curUrl.search + curUrl.hash);
                    }
                } catch (e) {}

                document.querySelectorAll('a[href]').forEach(function(a) {
                    var href = a.getAttribute('href');
                    if (href) a.setAttribute('href', addToken(href));
                });
                document.querySelectorAll('form').forEach(function(f) {
                    var act = f.getAttribute('action') || window.location.pathname;
                    f.setAttribute('action', addToken(act));
                });

                document.addEventListener('click', function(e) {
                    var a = e.target && e.target.closest ? e.target.closest('a[href]') : null;
                    if (!a) return;
                    var href = a.getAttribute('href');
                    if (href) a.setAttribute('href', addToken(href));
                }, true);

                document.addEventListener('submit', function(e) {
                    var f = e.target;
                    if (!f || f.tagName !== 'FORM') return;
                    var act = f.getAttribute('action') || window.location.pathname;
                    f.setAttribute('action', addToken(act));
                }, true);
            }
        })();
    </script>
    <%- include('ui_enhancements') %>
</body>
</html>
