<%- include('partials/page_start', { title: 'Assign Seller', pageHeading: 'Assign Seller' }) %>

<div class="register-container compact-form-wrap">
    <div class="register-card compact-card" style="max-width:460px;">
        <% if (products.length === 0) { %>
            <p class="empty-state">No unassigned products.</p>
            <a href="/register"><button type="button">Register Product</button></a>
        <% } else { %>
            <form action="/manufacturer/assign-product" method="POST">
                <label for="assignProductId">Product</label>
                <select id="assignProductId" name="product_id" required>
                    <% products.forEach(function(product) { %>
                        <option value="<%= product.id %>"><%= product.brand %> - <%= product.productName %> (#<%= product.serialNo %>)</option>
                    <% }) %>
                </select>

                <label for="assignSellerId">Seller</label>
                <select id="assignSellerId" name="seller_id" required>
                    <% sellers.forEach(function(seller) { %>
                        <option value="<%= seller.id %>"><%= seller.shopName %></option>
                    <% }) %>
                </select>

                <button type="submit">Assign</button>
            </form>
        <% } %>
    </div>
</div>

<%- include('partials/page_end') %>
