<%- include('partials/page_start', { title: 'Assign Buyer', pageHeading: 'Assign Buyer' }) %>

<div class="register-container compact-form-wrap">
    <div class="register-card compact-card" style="max-width:460px;">
        <% if (products.length === 0) { %>
            <p class="empty-state">No unassigned products.</p>
        <% } else { %>
            <form action="/seller/assign-product-consumer" method="POST">
                <label for="sellerProductId">Product</label>
                <select id="sellerProductId" name="product_id" required>
                    <% products.forEach(function(product) { %>
                        <option value="<%= product.id %>"><%= product.productName %> (#<%= product.serialNo %>)</option>
                    <% }) %>
                </select>

                <label for="sellerConsumerId">Consumer</label>
                <select id="sellerConsumerId" name="consumer_id" required>
                    <% consumers.forEach(function(consumer) { %>
                        <option value="<%= consumer.id %>"><%= consumer.fullName %></option>
                    <% }) %>
                </select>

                <button type="submit">Assign</button>
            </form>
        <% } %>
    </div>
</div>

<%- include('partials/page_end') %>
