<%- include('partials/page_start', { title: 'Ownership History', pageHeading: 'History #' + serial_no }) %>

<div class="panel">
    <div class="panel-head">
        <div class="panel-title">Serial #<%= serial_no %></div>
        <a href="/history" class="row-link">All Ledger</a>
    </div>

    <% if (history && history.length > 0) { %>
    <div class="ws-table-wrap">
        <table class="ws-table">
            <thead>
                <tr>
                    <th data-sort>From <%- include('partials/icon', { name: 'sort', px: 12 }) %></th>
                    <th data-sort>To <%- include('partials/icon', { name: 'sort', px: 12 }) %></th>
                    <th data-sort>Date <%- include('partials/icon', { name: 'sort', px: 12 }) %></th>
                    <th>Blockchain Hash</th>
                </tr>
            </thead>
            <tbody>
                <% history.forEach(function(row) { %>
                <tr>
                    <td><%= row.fromOwnerType %></td>
                    <td><%= row.toOwnerType %></td>
                    <td class="mono-cell"><%= row.transferDate %></td>
                    <td class="tx">
                        <span class="mono-copy" title="<%= row.blockchainHash %>">
                            <span><%= row.blockchainHash.length > 22 ? row.blockchainHash.slice(0, 12) + '…' + row.blockchainHash.slice(-8) : row.blockchainHash %></span>
                            <button type="button" class="copy-btn" data-copy="<%= row.blockchainHash %>" title="Copy hash" aria-label="Copy hash">
                                <%- include('partials/icon', { name: 'copy', px: 12 }) %>
                            </button>
                        </span>
                    </td>
                </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
    <% } else { %>
    <div class="empty-state">No ownership history found.</div>
    <% } %>
</div>

<%- include('partials/page_end') %>
