<%- include('partials/page_start', { title: 'Timeline', pageHeading: 'Timeline' }) %>

<div class="panel">
    <div class="timeline" style="margin:8px 0;">
        <% history.forEach(function(item) { %>
        <div class="timeline-item">
            <div class="timeline-circle"><%- include('partials/icon', { name: 'check', px: 18 }) %></div>
            <div class="timeline-content">
                <h2 class="icon-wrap">
                    <span><%= item.fromOwnerType %></span>
                    <%- include('partials/icon', { name: 'arrowRight', px: 18 }) %>
                    <span><%= item.toOwnerType %></span>
                </h2>
                <p class="mono-cell"><%= item.transferDate %></p>
                <small class="tx"><%= item.blockchainHash %></small>
            </div>
        </div>
        <% }) %>
    </div>
</div>

<%- include('partials/page_end') %>
