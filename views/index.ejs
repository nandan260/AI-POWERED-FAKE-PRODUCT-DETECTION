<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>ProductGuard</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --hp-ink: #2F4156;
            --hp-muted: #567C8D;
            --hp-mist: #C8D9E6;
            --hp-card: #fff;
            --hp-ease: cubic-bezier(.2, .7, .2, 1);
        }
        * { box-sizing: border-box; }
        body {
            margin: 0;
            background: var(--hp-mist);
            font-family: 'Plus Jakarta Sans', sans-serif;
            color: var(--hp-ink);
            -webkit-font-smoothing: antialiased;
        }
        a { color: var(--hp-ink); text-decoration: none; }
        a:hover { color: var(--hp-muted); }

        .hp-frame { min-height: 100vh; display: flex; }
        .hp-card {
            position: relative;
            flex: 1;
            min-height: 100vh;
            background: var(--hp-card);
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }
        .hp-canvas { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }

        .hp-nav {
            position: relative;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 32px;
            padding: 28px 24px;
            flex-wrap: wrap;
        }
        .hp-brand { display: flex; align-items: center; gap: 8px; font-weight: 700; font-size: 15px; }
        .hp-links { display: flex; gap: 28px; font-size: 14px; flex-wrap: wrap; justify-content: center; }
        .hp-links a { color: var(--hp-muted); }
        .hp-links a:hover { color: var(--hp-ink); }
        .hp-signin {
            padding: 8px 18px;
            background: var(--hp-ink);
            color: #fff;
            border-radius: 999px;
            font-size: 14px;
            font-weight: 600;
            transition: background .2s;
        }
        .hp-signin:hover { background: var(--hp-muted); color: #fff; }

        .hp-main {
            position: relative;
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 40px 24px;
            gap: 20px;
        }
        .hp-title {
            margin: 0;
            font-size: clamp(36px, 5vw, 64px);
            line-height: 1.08;
            font-weight: 600;
            letter-spacing: -0.035em;
        }
        .hp-title span { display: block; }
        .hp-title .hp-accent { color: var(--hp-muted); }
        .hp-lede {
            margin: 0;
            max-width: 420px;
            font-size: 16px;
            line-height: 1.6;
            color: var(--hp-muted);
            text-wrap: pretty;
        }

        /* Entrance: fade, rise and unblur, staggered by --d */
        .hp-in {
            opacity: 0;
            transform: translateY(18px);
            filter: blur(6px);
            transition: opacity 1s ease var(--d, 0s),
                        transform 1.1s var(--hp-ease) var(--d, 0s),
                        filter 1s ease var(--d, 0s);
        }
        .hp-ready .hp-in { opacity: 1; transform: none; filter: blur(0); }

        .hp-verify {
            margin-top: 12px;
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 6px 6px 6px 20px;
            width: min(100%, 440px);
            background: #fff;
            border: 1px solid var(--hp-mist);
            border-radius: 999px;
            box-shadow: 0 10px 30px -12px rgba(47, 65, 86, 0.25);
        }
        .hp-verify:focus-within {
            box-shadow: 0 0 0 6px rgba(200, 217, 230, 0.6), 0 10px 30px -12px rgba(47, 65, 86, 0.25);
        }
        .hp-verify input {
            flex: 1;
            min-width: 0;
            border: 0;
            outline: 0;
            font: inherit;
            font-size: 14px;
            background: transparent;
            color: var(--hp-ink);
        }
        .hp-verify button {
            height: 40px;
            padding: 0 20px;
            border: 0;
            border-radius: 999px;
            background: var(--hp-ink);
            color: #fff;
            font: inherit;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            box-shadow: 0 8px 18px -6px rgba(47, 65, 86, 0.28), 0 4px 14px -6px rgba(86, 124, 141, 0.25);
            transition: background .2s;
        }
        .hp-verify button:hover { background: var(--hp-muted); }

        .hp-steps {
            position: relative;
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 8px 40px;
            padding: 32px 24px 36px;
            font-size: 14px;
            font-weight: 600;
            color: var(--hp-muted);
            opacity: 0;
            transition: opacity 1s ease .8s;
        }
        .hp-ready .hp-steps { opacity: 1; }
        .hp-step { display: flex; align-items: center; gap: 8px; transition: color .5s; }
        .hp-step-dot {
            width: 6px;
            height: 6px;
            border-radius: 999px;
            background: var(--hp-ink);
            opacity: 0;
            transform: scale(0);
            transition: opacity .5s, transform .5s;
        }
        .hp-step-n { font-size: 12px; font-weight: 500; }
        .hp-step.is-active { color: var(--hp-ink); }
        .hp-step.is-active .hp-step-dot { opacity: 1; transform: scale(1); }

        @media (max-width: 600px) {
            .hp-nav { gap: 16px; }
            .hp-links { gap: 16px; }
        }
        @media (prefers-reduced-motion: reduce) {
            .hp-in, .hp-steps, .hp-step, .hp-step-dot { transition: none; }
        }
    </style>
</head>
<body>
<div class="hp-frame">
    <div class="hp-card" id="hpCard">
        <canvas class="hp-canvas" id="hpCanvas" aria-hidden="true"></canvas>

        <nav class="hp-nav">
            <a href="/" class="hp-brand">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="#2F4156" aria-hidden="true"><path d="M12 2 4 5v7c0 6 8 10 8 10s8-4 8-10V5z"></path></svg>
                ProductGuard
            </a>
            <div class="hp-links">
                <a href="/manufacturer/dashboard">Manufacturer</a>
                <a href="/seller/dashboard">Seller</a>
                <a href="/consumer/dashboard">Consumer</a>
                <a href="/history">History</a>
            </div>
            <a href="/consumer/login" class="hp-signin">Sign in</a>
        </nav>

        <main class="hp-main">
            <h1 class="hp-title">
                <span class="hp-accent hp-in" style="--d:.1s">AI Powered</span>
                <span class="hp-in" style="--d:.25s">Fake Product Detection</span>
            </h1>
            <p class="hp-lede hp-in" style="--d:.45s">Verify product authenticity using AI, Blockchain and QR Code Verification.</p>
            <form class="hp-verify hp-in" style="--d:.6s" id="hpVerify" action="/verify" method="GET">
                <input id="hpSerial" placeholder="Enter product serial number" aria-label="Product serial number" autocomplete="off" required>
                <button type="submit">Verify</button>
            </form>
        </main>

        <footer class="hp-steps" id="hpSteps">
            <% ['Manufacturer', 'Seller', 'Consumer', 'AI Verification', 'Blockchain'].forEach(function(title, i) { %>
            <span class="hp-step<%= i === 0 ? ' is-active' : '' %>">
                <span class="hp-step-dot"></span>
                <span class="hp-step-n">0<%= i + 1 %></span><%= title %>
            </span>
            <% }); %>
        </footer>
    </div>
</div>

<script>
(function () {
    var card = document.getElementById('hpCard');
    var canvas = document.getElementById('hpCanvas');
    var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Serial lookup goes to /verify/<serial>, keeping the auth token when present.
    var form = document.getElementById('hpVerify');
    form.addEventListener('submit', function (e) {
        e.preventDefault();
        var serial = document.getElementById('hpSerial').value.trim();
        if (!serial) return;
        var url = '/verify/' + encodeURIComponent(serial);
        window.location.href = window.pgWithAuth ? window.pgWithAuth(url) : url;
    });

    // Entrance animation.
    setTimeout(function () { card.classList.add('hp-ready'); }, 60);

    // Cycle the active workflow step.
    var steps = document.querySelectorAll('#hpSteps .hp-step');
    var active = 0;
    setInterval(function () {
        steps[active].classList.remove('is-active');
        active = (active + 1) % steps.length;
        steps[active].classList.add('is-active');
    }, 1800);

    // Animated dot field.
    var ctx, w, h, dots = [], t0 = 0;
    function build() {
        var dpr = window.devicePixelRatio || 1;
        w = canvas.offsetWidth;
        h = canvas.offsetHeight;
        canvas.width = w * dpr;
        canvas.height = h * dpr;
        ctx = canvas.getContext('2d');
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        var seed = 7;
        function rnd() { return (seed = (seed * 16807) % 2147483647) / 2147483647; }
        var blobs = [
            { cx: w * 0.1, cy: h * 0.55, rx: w * 0.22, ry: h * 0.2 },
            { cx: w * 0.92, cy: h * 0.6, rx: w * 0.2, ry: h * 0.18 }
        ];
        dots = [];
        for (var py = 0; py < h; py += 7) {
            for (var px = 0; px < w; px += 7) {
                var d = 0;
                for (var i = 0; i < blobs.length; i++) {
                    var b = blobs[i];
                    var dx = (px - b.cx) / b.rx, dy = (py - b.cy) / b.ry;
                    d = Math.max(d, 1 - Math.sqrt(dx * dx + dy * dy));
                }
                d += Math.sin(px * 0.02 + py * 0.05) * 0.12;
                if (d <= -0.15 || rnd() > Math.max(d, 0.04) * 1.6) continue;
                dots.push({ px: px, py: py, d: d, ph: rnd() * 6.28, delay: Math.abs(px - w / 2) / w * 900 });
            }
        }
    }
    function frame(t) {
        if (!ctx) return;
        if (!t0) t0 = t;
        var e = reduceMotion ? 1e6 : t - t0;
        var s = reduceMotion ? 0 : t / 1000;
        ctx.clearRect(0, 0, w, h);
        ctx.fillStyle = '#2F4156';
        for (var i = 0; i < dots.length; i++) {
            var p = dots[i];
            var intro = Math.min(1, Math.max(0, (e - p.delay) / 700));
            if (intro <= 0) continue;
            var wave = Math.sin(p.px * 0.012 - s * 1.2 + p.py * 0.02) * 0.22 + Math.sin(s * 2 + p.ph) * 0.08;
            var d = p.d + wave;
            if (d <= 0) continue;
            ctx.globalAlpha = Math.min(1, d * 1.5) * intro;
            var dy = Math.sin(s * 0.8 + p.px * 0.01) * 2;
            ctx.beginPath();
            ctx.arc(p.px, p.py + dy, 0.5 + Math.min(1, d) * 1.6, 0, 6.283);
            ctx.fill();
        }
        ctx.globalAlpha = 1;
    }
    function loop(t) { frame(t); if (!reduceMotion) requestAnimationFrame(loop); }
    window.addEventListener('resize', function () { build(); if (reduceMotion) frame(performance.now()); });
    build();
    requestAnimationFrame(loop);
})();
</script>

<%# The shared footer partial starts with </main> and adds the auth-token and toast scripts. %>
<main hidden>
<%- include('partials/footer') %>
