<%
const d = dash;
const initial = (d.companyName || '?').trim().charAt(0).toUpperCase();
const dayLabels = ['S', 'M', 'T', 'W', 'T', 'F', 'S'];
const dayNames = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
const maxDay = Math.max(1, ...d.weekdayCounts);
const peak = d.weekdayCounts.indexOf(Math.max(...d.weekdayCounts));
const today = new Date().getDay();
// Gauge: semicircle of radius 80 has length PI * 80.
const arcLen = Math.PI * 80;
const shortHash = d.lastHash ? d.lastHash.slice(0, 10) + '…' + d.lastHash.slice(-6) : '—';
const ownerRoute = {
  Consumer: { route: 'Seller → Consumer', status: 'Delivered', cls: 'is-done' },
  Seller: { route: 'Manufacturer → Seller', status: 'With seller', cls: 'is-done' },
  Manufacturer: { route: 'Awaiting seller', status: 'Registered', cls: '' }
};
const nav = [
  { label: 'Dashboard', href: '/manufacturer/dashboard', active: true },
  { label: 'Products', href: '/manufacturer/products', badge: d.total },
  { label: 'Register', href: '/register' },
  { label: 'Assign Seller', href: '/manufacturer/assign' },
  { label: 'Ledger', href: '/history' }
];
%>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Dashboard · <%= d.companyName %> · ProductGuard</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/static/pg-v2.css">
    <style>
        .md-shell { min-height: 100vh; display: flex; gap: 12px; padding: 12px; background: #fff; }

        .md-side {
            width: 220px;
            flex-shrink: 0;
            display: flex;
            flex-direction: column;
            gap: 28px;
            padding: 24px 16px 16px;
            background: var(--v2-panel);
            border-radius: 20px;
            position: sticky; top: 12px; height: calc(100vh - 24px); overflow-y: auto;
        }
        .md-brand { display: flex; align-items: center; gap: 10px; padding: 0 10px; font-weight: 700; font-size: 16px; }
        .md-brand-mark {
            width: 30px; height: 30px; border-radius: 10px; background: var(--v2-ink);
            display: flex; align-items: center; justify-content: center;
        }
        .md-group { display: flex; flex-direction: column; gap: 4px; }
        .md-group-label { padding: 0 12px 8px; font-size: 11px; font-weight: 600; letter-spacing: .1em; color: var(--v2-muted); }
        .md-nav {
            height: 40px; padding: 0 12px; border-radius: 12px;
            display: flex; align-items: center; justify-content: space-between;
            font-size: 14px; font-weight: 500; color: var(--v2-muted);
            transition: background .15s;
        }
        .md-nav:hover { background: var(--v2-wash); color: var(--v2-ink); }
        .md-nav.is-active { background: #fff; color: var(--v2-ink); font-weight: 600; }
        .md-badge { padding: 2px 7px; border-radius: 6px; background: var(--v2-ink); color: #fff; font-size: 11px; font-weight: 600; }
        .md-cta {
            margin-top: auto; padding: 18px; border-radius: 18px; background: var(--v2-ink); color: #fff;
            display: flex; flex-direction: column; gap: 14px;
            background-image: radial-gradient(160px 120px at 100% 0%, rgba(200, 217, 230, .25), transparent);
        }
        .md-cta strong { font-size: 16px; font-weight: 600; line-height: 1.3; }
        .md-cta a {
            height: 38px; border-radius: 999px; background: #fff; color: var(--v2-ink);
            display: flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 600;
            transition: background .2s;
        }
        .md-cta a:hover { background: var(--v2-mist); color: var(--v2-ink); }

        .md-col { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 12px; }
        .md-top {
            display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap;
            padding: 12px 16px; background: var(--v2-panel); border-radius: 20px;
        }
        .md-search {
            display: flex; align-items: center; gap: 10px; height: 44px; width: min(100%, 320px);
            padding: 0 8px 0 16px; background: #fff; border-radius: 999px; border: 1px solid transparent;
        }
        .md-search:focus-within { border-color: var(--v2-mist); }
        .md-search input { flex: 1; min-width: 0; border: 0; outline: 0; font: inherit; font-size: 13px; background: transparent; color: var(--v2-ink); }
        .md-kbd { padding: 3px 8px; border-radius: 6px; background: var(--v2-wash); font-size: 11px; font-weight: 600; color: var(--v2-muted); }
        .md-user { display: flex; align-items: center; gap: 10px; }
        .md-avatar {
            width: 40px; height: 40px; border-radius: 999px; background: var(--v2-ink); color: #fff;
            display: flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 700;
        }
        .md-user-meta { display: flex; flex-direction: column; }
        .md-user-meta strong { font-size: 14px; font-weight: 600; }
        .md-user-meta span { font-size: 12px; color: var(--v2-muted); }

        .md-main { flex: 1; display: flex; flex-direction: column; gap: 12px; padding: 20px; background: var(--v2-panel); border-radius: 20px; }
        .md-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; flex-wrap: wrap; padding-bottom: 6px; }
        .md-head h1 { margin: 0; font-size: 34px; font-weight: 600; letter-spacing: -.035em; }
        .md-actions { display: flex; gap: 10px; flex-wrap: wrap; }

        .md-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 12px; }
        .md-stat { padding: 20px; border-radius: 20px; background: #fff; display: flex; flex-direction: column; gap: 16px; }
        .md-stat-top { display: flex; justify-content: space-between; align-items: center; font-size: 15px; font-weight: 500; }
        .md-stat-arrow {
            width: 30px; height: 30px; border-radius: 999px; border: 1px solid var(--v2-mist);
            display: flex; align-items: center; justify-content: center; font-size: 14px;
        }
        .md-stat-value { font-size: 48px; font-weight: 600; letter-spacing: -.04em; line-height: 1; }
        .md-stat-note { font-size: 12px; color: var(--v2-muted); }
        .md-stat.is-dark {
            background: var(--v2-ink); color: #fff;
            background-image: radial-gradient(220px 140px at 0% 100%, rgba(200, 217, 230, .22), transparent);
        }
        .md-stat.is-dark .md-stat-arrow { background: #fff; color: var(--v2-ink); border: 0; }
        .md-stat.is-dark .md-stat-note { color: var(--v2-mist); }

        .md-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
        .md-card { min-width: 0; padding: 20px; border-radius: 20px; background: #fff; display: flex; flex-direction: column; gap: 14px; }
        .md-card-title { font-size: 16px; font-weight: 600; }
        .md-span2 { grid-column: span 2; }
        .md-rows2 { grid-row: span 2; }

        .md-bars { flex: 1; min-height: 150px; display: grid; grid-template-columns: repeat(7, 1fr); gap: 12px; align-items: end; }
        .md-bar-col { display: flex; flex-direction: column; align-items: center; gap: 8px; height: 100%; justify-content: flex-end; }
        .md-bar {
            width: 100%; max-width: 44px; min-height: 8px; border-radius: 999px;
            background: repeating-linear-gradient(45deg, var(--v2-mist) 0 3px, #fff 3px 8px);
            border: 1px solid var(--v2-mist);
        }
        .md-bar.is-peak { background: var(--v2-ink); border: 0; }
        .md-bar.is-today { background: var(--v2-muted); border: 0; }
        .md-bar-col span { font-size: 12px; color: var(--v2-muted); }

        .md-latest strong { font-size: 22px; font-weight: 600; letter-spacing: -.02em; line-height: 1.2; }
        .md-latest .v2-mono { font-size: 12px; color: var(--v2-muted); }
        .md-latest .v2-btn { margin-top: auto; }

        .md-card-head { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
        .md-chip {
            height: 30px; padding: 0 12px; border: 1px solid var(--v2-ink); border-radius: 999px;
            display: inline-flex; align-items: center; font-size: 12px; font-weight: 600; white-space: nowrap; flex-shrink: 0;
        }
        .md-chip:hover { background: var(--v2-ink); color: #fff; }
        .md-item { display: flex; align-items: center; gap: 12px; border-radius: 12px; }
        .md-item img { width: 40px; height: 40px; flex-shrink: 0; border-radius: 12px; object-fit: cover; background: var(--v2-wash); }
        .md-item-text { flex: 1; min-width: 0; display: flex; flex-direction: column; }
        .md-item-text strong { font-size: 13px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .md-item-text .v2-mono { font-size: 11px; color: var(--v2-muted); }
        .md-item:hover strong { color: var(--v2-muted); }

        .md-activity img { width: 38px; height: 38px; border-radius: 999px; }
        .md-activity .md-item-text strong { font-size: 14px; }
        .md-activity .md-item-text span { font-size: 12px; color: var(--v2-muted); }
        .md-status {
            padding: 4px 10px; border-radius: 999px; font-size: 11px; font-weight: 600; white-space: nowrap;
            background: #fff; color: var(--v2-muted); border: 1px solid var(--v2-mist);
        }
        .md-status.is-done { background: var(--v2-wash); color: var(--v2-ink); }

        .md-gauge { position: relative; display: flex; justify-content: center; padding-bottom: 8px; }
        .md-gauge svg { width: 100%; max-width: 220px; }
        .md-gauge-val { position: absolute; bottom: 0; left: 0; right: 0; display: flex; flex-direction: column; align-items: center; }
        .md-gauge-val strong { font-size: 34px; font-weight: 600; letter-spacing: -.04em; line-height: 1; }
        .md-gauge-val span { font-size: 12px; color: var(--v2-muted); white-space: nowrap; }
        .md-legend { display: flex; justify-content: center; gap: 16px; font-size: 12px; color: var(--v2-muted); padding-top: 6px; }
        .md-legend span { display: flex; align-items: center; gap: 6px; }
        .md-dot { width: 8px; height: 8px; border-radius: 999px; }

        .md-chain {
            padding: 20px 22px; border-radius: 20px; background: var(--v2-ink); color: #fff;
            display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap;
            background-image: radial-gradient(300px 120px at 100% 50%, rgba(200, 217, 230, .2), transparent);
        }
        .md-chain-meta { display: flex; flex-direction: column; gap: 4px; }
        .md-chain-meta span { font-size: 13px; color: var(--v2-mist); }
        .md-chain-meta strong { font-family: var(--v2-mono); font-size: 20px; font-weight: 500; }
        .md-chain > .v2-mono { font-size: 13px; color: var(--v2-mist); white-space: nowrap; }

        @media (max-width: 1100px) {
            .md-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
            .md-rows2 { grid-row: auto; }
        }
        @media (max-width: 860px) {
            .md-shell { flex-direction: column; padding: 8px; }
            .md-side { position: static; height: auto; width: auto; gap: 16px; padding: 16px; }
            .md-side .md-group:first-of-type { flex-direction: row; flex-wrap: wrap; }
            .md-group-label { display: none; }
            .md-cta { display: none; }
            .md-grid { grid-template-columns: minmax(0, 1fr); }
            .md-span2 { grid-column: auto; }
            .md-head h1 { font-size: 28px; }
            .md-user-meta { display: none; }
        }
    </style>
</head>
<body>
<div class="md-shell">
    <aside class="md-side">
        <a href="/" class="md-brand">
            <span class="md-brand-mark"><svg width="15" height="15" viewBox="0 0 24 24" fill="#fff" aria-hidden="true"><path d="M12 2 4 5v7c0 6 8 10 8 10s8-4 8-10V5z"></path></svg></span>
            ProductGuard
        </a>
        <nav class="md-group" aria-label="Menu">
            <span class="md-group-label">MENU</span>
            <% nav.forEach(function (n) { %>
            <a href="<%= n.href %>" class="md-nav<%= n.active ? ' is-active' : '' %>"<%- n.active ? ' aria-current="page"' : '' %>>
                <span><%= n.label %></span>
                <% if (n.badge !== undefined) { %><span class="md-badge"><%= n.badge %></span><% } %>
            </a>
            <% }); %>
        </nav>
        <div class="md-group">
            <span class="md-group-label">GENERAL</span>
            <a href="/manufacturer/logout" class="md-nav">Logout</a>
        </div>
        <div class="md-cta">
            <strong>New batch ready?</strong>
            <a href="/register">Register product</a>
        </div>
    </aside>

    <div class="md-col">
        <header class="md-top">
            <label class="md-search">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#567C8D" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
                <input id="mdSearch" type="search" placeholder="Search serial or product" aria-label="Search serial or product" autocomplete="off">
                <span class="md-kbd" id="mdKbd">Ctrl K</span>
            </label>
            <div class="md-user">
                <div class="md-avatar" aria-hidden="true"><%= initial %></div>
                <div class="md-user-meta"><strong><%= d.companyName %></strong><span>Manufacturer</span></div>
            </div>
        </header>

        <main class="md-main">
            <div class="md-head">
                <h1>Dashboard</h1>
                <div class="md-actions">
                    <a href="/register" class="v2-btn">+ Register product</a>
                    <button type="button" class="v2-btn v2-btn-ghost" id="mdExport">Export</button>
                </div>
            </div>

            <div class="md-stats">
                <div class="md-stat is-dark">
                    <div class="md-stat-top"><span>Total products</span><span class="md-stat-arrow" aria-hidden="true">↗</span></div>
                    <span class="md-stat-value"><%= d.total %></span>
                    <span class="md-stat-note"><%= d.registered %> awaiting a seller</span>
                </div>
                <% [
                    { label: 'Verified genuine', value: d.genuine, note: 'AI checked' },
                    { label: 'With consumer', value: d.withConsumer, note: 'Sold through' },
                    { label: 'Flagged', value: d.flagged, note: d.flagged ? 'Needs review' : 'Nothing to review' }
                ].forEach(function (s) { %>
                <div class="md-stat">
                    <div class="md-stat-top"><span><%= s.label %></span><span class="md-stat-arrow" aria-hidden="true">↗</span></div>
                    <span class="md-stat-value"><%= s.value %></span>
                    <span class="md-stat-note"><%= s.note %></span>
                </div>
                <% }); %>
            </div>

            <div class="md-grid">
                <section class="md-card md-span2">
                    <span class="md-card-title">Transfers by day of week</span>
                    <div class="md-bars">
                        <% d.weekdayCounts.forEach(function (n, i) {
                            const cls = n > 0 && i === peak ? ' is-peak' : (i === today ? ' is-today' : ''); %>
                        <div class="md-bar-col" title="<%= dayNames[i] %>: <%= n %> transfer<%= n === 1 ? '' : 's' %>">
                            <div class="md-bar<%= cls %>" style="height:<%= Math.max(6, Math.round(n / maxDay * 100)) %>%"></div>
                            <span><%= dayLabels[i] %></span>
                        </div>
                        <% }); %>
                    </div>
                </section>

                <section class="md-card md-latest">
                    <span class="md-card-title">Latest transfer</span>
                    <% if (d.latestTransfer) { %>
                    <strong>#<%= d.latestTransfer.serialNo %> to <%= d.latestTransfer.toOwnerType %></strong>
                    <span class="v2-mono"><%= d.latestTransfer.date %></span>
                    <a href="/history/<%= encodeURIComponent(d.latestTransfer.serialNo) %>" class="v2-btn">View on chain</a>
                    <% } else { %>
                    <p class="v2-empty">No transfers yet. Assign a product to a seller to start its custody chain.</p>
                    <a href="/manufacturer/assign" class="v2-btn">Assign seller</a>
                    <% } %>
                </section>

                <section class="md-card md-rows2">
                    <div class="md-card-head">
                        <span class="md-card-title">Products</span>
                        <a href="/register" class="md-chip">+ New</a>
                    </div>
                    <div id="mdProducts" style="display:flex;flex-direction:column;gap:14px">
                        <% d.products.slice(0, 6).forEach(function (p) { %>
                        <a href="/product/<%= p.id %>" class="md-item" data-search="<%= (p.modelName + ' ' + p.productName + ' ' + p.serialNo).toLowerCase() %>">
                            <img src="/static/product_images/<%= p.image %>" alt="" loading="lazy">
                            <span class="md-item-text"><strong><%= p.modelName %></strong><span class="v2-mono">#<%= p.serialNo %></span></span>
                        </a>
                        <% }); %>
                        <p class="v2-empty" data-empty <%= d.products.length ? 'hidden' : '' %>><%= d.products.length ? 'No matching products.' : 'No products yet.' %></p>
                    </div>
                </section>

                <section class="md-card md-span2 md-activity">
                    <span class="md-card-title">Recent activity</span>
                    <div id="mdActivity" style="display:flex;flex-direction:column;gap:14px">
                        <% d.products.slice(0, 4).forEach(function (p) { const r = ownerRoute[p.owner] || ownerRoute.Manufacturer; %>
                        <div class="md-item" data-search="<%= (p.modelName + ' ' + p.productName + ' ' + p.serialNo).toLowerCase() %>">
                            <img src="/static/product_images/<%= p.image %>" alt="" loading="lazy">
                            <span class="md-item-text"><strong><%= p.modelName %> <span class="v2-mono">#<%= p.serialNo %></span></strong><span><%= r.route %></span></span>
                            <span class="md-status <%= r.cls %>"><%= r.status %></span>
                        </div>
                        <% }); %>
                        <p class="v2-empty" data-empty <%= d.products.length ? 'hidden' : '' %>><%= d.products.length ? 'No matching activity.' : 'No activity yet.' %></p>
                    </div>
                </section>

                <section class="md-card">
                    <span class="md-card-title">Supply chain</span>
                    <div class="md-gauge">
                        <svg viewBox="0 0 200 110" role="img" aria-label="<%= d.consumerPercent %>% of products are with a consumer">
                            <defs><pattern id="mdStripe" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><rect width="6" height="6" fill="#fff"></rect><line x1="0" y1="0" x2="0" y2="6" stroke="#C8D9E6" stroke-width="3"></line></pattern></defs>
                            <path d="M20 100 A80 80 0 0 1 180 100" fill="none" stroke="url(#mdStripe)" stroke-width="22" stroke-linecap="round"></path>
                            <% if (d.consumerPercent > 0) { %>
                            <path d="M20 100 A80 80 0 0 1 180 100" fill="none" stroke="#2F4156" stroke-width="22" stroke-linecap="round" stroke-dasharray="<%= (arcLen * d.consumerPercent / 100).toFixed(1) %> 300"></path>
                            <% } %>
                        </svg>
                        <div class="md-gauge-val"><strong><%= d.consumerPercent %>%</strong><span>with consumer</span></div>
                    </div>
                    <div class="md-legend">
                        <span><span class="md-dot" style="background:#2F4156"></span>Consumer</span>
                        <span><span class="md-dot" style="background:#C8D9E6"></span>Earlier stage</span>
                    </div>
                </section>
            </div>

            <div class="md-chain">
                <div class="md-chain-meta"><span>Chain synced</span><strong><%= d.txCount %> transaction<%= d.txCount === 1 ? '' : 's' %></strong></div>
                <span class="v2-mono" title="<%= d.lastHash %>"><%= shortHash %></span>
            </div>
        </main>
    </div>
</div>

<script>
(function () {
    var products = <%- JSON.stringify(d.products).replace(/</g, '\\u003c') %>;

    // Search filters the Products and Recent activity lists.
    var search = document.getElementById('mdSearch');
    var kbd = document.getElementById('mdKbd');
    if (/Mac|iPhone|iPad/.test(navigator.platform || navigator.userAgent)) kbd.textContent = '⌘K';
    function filter() {
        var q = search.value.trim().toLowerCase();
        ['mdProducts', 'mdActivity'].forEach(function (id) {
            var box = document.getElementById(id);
            var items = box.querySelectorAll('[data-search]');
            var shown = 0;
            items.forEach(function (el) {
                var hit = !q || el.getAttribute('data-search').indexOf(q) !== -1;
                el.hidden = !hit;
                if (hit) shown++;
            });
            var empty = box.querySelector('[data-empty]');
            if (empty && items.length) empty.hidden = shown > 0;
        });
    }
    search.addEventListener('input', filter);
    document.addEventListener('keydown', function (e) {
        if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); search.focus(); search.select(); }
        if (e.key === 'Escape' && document.activeElement === search) { search.value = ''; filter(); search.blur(); }
    });

    // Export all products as CSV.
    document.getElementById('mdExport').addEventListener('click', function () {
        var cols = ['serialNo', 'productName', 'modelName', 'owner', 'status', 'blockchainTx'];
        var head = ['Serial', 'Product', 'Model', 'Current owner', 'Status', 'Blockchain TX'];
        var cell = function (v) { v = String(v == null ? '' : v); return /[",\n]/.test(v) ? '"' + v.replace(/"/g, '""') + '"' : v; };
        var csv = [head.join(',')].concat(products.map(function (p) { return cols.map(function (c) { return cell(p[c]); }).join(','); })).join('\n');
        var url = URL.createObjectURL(new Blob([csv], { type: 'text/csv' }));
        var a = document.createElement('a');
        a.href = url;
        a.download = 'products-' + new Date().toISOString().slice(0, 10) + '.csv';
        document.body.appendChild(a);
        a.click();
        a.remove();
        setTimeout(function () { URL.revokeObjectURL(url); }, 1000);
        if (window.pgToast) window.pgToast('Exported ' + products.length + ' products');
    });
})();
</script>

<%# The shared footer partial starts with </main> and adds the auth-token and toast scripts. %>
<main hidden>
<%- include('partials/footer') %>
