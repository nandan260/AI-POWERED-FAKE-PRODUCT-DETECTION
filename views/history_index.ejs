<%- include('partials/page_start', { title: 'Ledger', pageHeading: 'Ledger' }) %>

<div class="panel dash-table-panel" style="height:100%;">
    <div class="table-toolbar">
        <span class="panel-title">Blockchain Ledger</span>
        <form class="ledger-search-form" onsubmit="event.preventDefault(); const s = document.getElementById('serialSearch').value.trim(); if (s) { const u = '/history/' + encodeURIComponent(s); window.location.href = window.pgWithAuth ? window.pgWithAuth(u) : u; }">
            <input type="text" id="serialSearch" class="ws-search-input ledger-search-input" placeholder="Serial #..." aria-label="Serial number lookup">
            <button type="submit" class="ws-primary-btn">
                <%- include('partials/icon', { name: 'search', px: 15 }) %>
                <span>Lookup</span>
            </button>
        </form>
    </div>

    <div class="ws-table-wrap">
        <table class="ws-table">
            <thead>
                <tr>
                    <th scope="col" data-sort>Serial <%- include('partials/icon', { name: 'sort', px: 12 }) %></th>
                    <th scope="col" data-sort>Product <%- include('partials/icon', { name: 'sort', px: 12 }) %></th>
                    <th scope="col" data-sort>From <%- include('partials/icon', { name: 'sort', px: 12 }) %></th>
                    <th scope="col" data-sort>To <%- include('partials/icon', { name: 'sort', px: 12 }) %></th>
                    <th scope="col" data-sort>Date <%- include('partials/icon', { name: 'sort', px: 12 }) %></th>
                    <th scope="col">Hash</th>
                    <th scope="col"><span class="sr-only">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                <% records.forEach(function(rec) { %>
                <tr>
                    <td class="mono-cell">
                        <span class="mono-copy">
                            <span><%= rec.serialNo %></span>
                            <button type="button" class="copy-btn" data-copy="<%= rec.serialNo %>" title="Copy serial" aria-label="Copy serial">
                                <%- include('partials/icon', { name: 'copy', px: 12 }) %>
                            </button>
                        </span>
                    </td>
                    <td><%= rec.brand %> · <%= rec.productName %></td>
                    <td><%= rec.fromOwnerType %></td>
                    <td><%= rec.toOwnerType %></td>
                    <td class="mono-cell"><%= rec.transferDate %></td>
                    <td class="tx">
                        <span class="mono-copy" title="<%= rec.blockchainHash %>">
                            <span><%= rec.blockchainHash.length > 18 ? rec.blockchainHash.slice(0, 10) + '…' + rec.blockchainHash.slice(-6) : rec.blockchainHash %></span>
                            <button type="button" class="copy-btn" data-copy="<%= rec.blockchainHash %>" title="Copy hash" aria-label="Copy hash">
                                <%- include('partials/icon', { name: 'copy', px: 12 }) %>
                            </button>
                        </span>
                    </td>
                    <td><a href="/history/<%= rec.serialNo %>" class="row-link">View</a></td>
                </tr>
                <% }) %>
            </tbody>
        </table>
        <% if (records.length === 0) { %>
        <div class="empty-state-box">
            <p>No ledger records yet.</p>
            <a href="/verify"><button type="button" class="ws-primary-btn">Lookup Serial</button></a>
        </div>
        <% } %>
    </div>
</div>

<%- include('partials/page_end') %>
